{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Recreated locally — the Replit export omitted this shared base that every package extends. Kept to standard `strict` (not extra-strict) to match how the existing code was written.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  }
}
