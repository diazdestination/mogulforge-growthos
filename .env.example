# MogulForge — environment template.
# Local dev: copy to artifacts/api-server/.env  (the API has no dotenv; start-dev.ps1 loads this).
# Docker:    copy to .env at the repo root      (docker compose reads it automatically).

# API server port
PORT=3001

# Postgres connection.
#   local dev  -> host  localhost
#   docker     -> host  db   (the compose service name)
DATABASE_URL=postgresql://postgres:mogulforge@localhost:5432/mogulforge

# Email Intelligence Inbox (founding beta). Leave blank until the inbound
# provider bridge and DNS are deliberately configured. Keys must decode to
# exactly 32 bytes and must not reuse the OAuth token encryption key.
EMAIL_INGESTION_DOMAIN=
EMAIL_INGESTION_WEBHOOK_SECRET=
EMAIL_INTELLIGENCE_ENCRYPTION_KEY=

# Long random string that signs sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin used for same-origin authorization and links in email.
APP_ORIGIN=http://localhost:5000

# --- MogulForge transactional account email ---
# Required in production for account verification, password recovery, and
# team invitations. This platform-owned channel is intentionally separate
# from each user's connected Gmail account. RESEND_FROM_EMAIL must use a
# sender/domain verified in Resend; production fails closed when either value
# is absent so GrowthOS never reports an undelivered identity email as sent.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MogulForge <account@mogulforge.ai>
# Stable nonsecret provider-account/environment label for identity delivery
# evidence. Required alongside the verified sender; use separate staging and
# production values and change it when the provider account changes.
# PLATFORM_EMAIL_DELIVERY_CONTEXT=staging-account-v1
# Required for Resend delivery callbacks; missing/malformed signing secrets
# reject all requests, including in local development. Never commit real keys.
# RESEND_WEBHOOK_SECRET=whsec_...

# Staging email acceptance requires a released hold, explicit approval and
# exact approved inboxes together. The deployed staging config keeps them off.
# GROWTHOS_OUTBOUND_HOLD=true
# STAGING_OUTBOUND_APPROVED=false
# STAGING_EMAIL_RECIPIENT_ALLOWLIST=qa@example.test,owner@example.test

# Founding-beta access gate. In production, new self-service registrations are
# rejected unless their lowercase email appears in this comma-separated list.
# Users pre-provisioned through the in-app team invite flow are always allowed
# and their signed invitation proves mailbox control at account creation.
# Local development and tests stay open when this is unset.
# BETA_SIGNUP_ALLOWLIST=founder@example.com,beta-owner@example.com

# --- Per-user Gmail OAuth (GrowthOS users connect their own mailbox) ---
# Create separate Google Cloud OAuth clients/projects for local testing and production.
# Request only Gmail send access; never store these values in source control.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/integrations/gmail/callback
# 32 random bytes encoded as base64 or 64 hex characters. Rotating this key
# requires a credential re-encryption migration or users must reconnect.
# OAUTH_TOKEN_ENCRYPTION_KEY=...

# --- Per-user Microsoft 365 / Outlook delegated email ---
# Register a separate Entra application per environment. Request Mail.Send,
# User.Read and offline_access only. No inbox reading or shared-mailbox send-as.
# The callback is APP_ORIGIN + /api/v1/integrations/microsoft/callback.
# Users connect and explicitly select their own sender in My Profile. Existing
# Gmail stays supported; Microsoft never silently becomes a fallback sender.
# MICROSOFT_OAUTH_CLIENT_ID=...
# MICROSOFT_OAUTH_CLIENT_SECRET=...
# MICROSOFT_OAUTH_TENANT_ID=common
# Uses the same encrypted-credential key above with separate actor/org/provider
# encryption context. Do not change that key without a re-encryption plan.

# --- Explicit Microsoft mailbox reply reading (separate from Mail.Send) ---
# Default-off. Existing sender consent never grants reading. The selected sender
# must deliberately authorize a separate Mail.Read/User.Read/offline_access flow
# for the same account/revision. Callback: /api/v1/mailbox/microsoft/callback.
# No Mail.ReadWrite, shared-mailbox delegation, attachments or historical crawl.
# Keep disabled until provider/read-scope/retention and release approval.
MICROSOFT_MAILBOX_READ_ENABLED=false

# --- Zapier Connected Apps (contractor-owned Zapier MCP servers) ---
# Each contractor connects their own Zapier account through the Zapier MCP
# Embed in Settings -> Connections. Zapier returns a per-organization MCP
# server URL that GrowthOS stores application-encrypted with the key above.
# Create the embed at https://mcp.zapier.com/manage/embed/config with the
# app's public origin as the allowed domain. The embed id is not secret and is
# sent to the browser; the embed secret authenticates GrowthOS to Zapier and
# must never reach a browser, log, or git. Zapier task usage is billed to the
# contractor's own Zapier account. Both unset = feature hidden.
# ZAPIER_MCP_EMBED_ID=...
# ZAPIER_MCP_EMBED_SECRET=...

# --- BILL card & bank collection (Stripe Connect) ---
# Uses the platform STRIPE_SECRET_KEY above. Each contractor connects its own
# Stripe Standard account in Settings -> Connections; payments settle to them.
# Enable Connect in the Stripe dashboard and add a *Connect* webhook endpoint
# (events from connected accounts) at APP_ORIGIN + /api/billing/connect-webhook
# for: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# account.updated. Its signing secret is separate from STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Optional platform fee on each invoice payment, in basis points (0 = none, max 2000).
# STRIPE_CONNECT_APPLICATION_FEE_BPS=0

# --- Opt-in STAFF new-lead web push, not customer SMS ---
# Disabled by default. Configure a reviewed tenant routing policy and each
# user's own device opt-in; retain outbound holds until supervised acceptance.
WEB_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=...
# WEB_PUSH_VAPID_PRIVATE_KEY=...
# WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.test
# STAGING_PUSH_USER_ALLOWLIST=
# VAPID is a matched P-256 key pair; subscriptions are encrypted using
# OAUTH_TOKEN_ENCRYPTION_KEY. No browser app bundle may contain private keys.
# Staging additionally requires explicit STAGING_OUTBOUND_APPROVED=true,
# GROWTHOS_OUTBOUND_HOLD=false and exact authorized staff user IDs together.
# Manual phone-text PREPARATION does not use Twilio or this sending flag.

# Portable default stores private photo uploads in Postgres. Legacy Replit/GCS
# remains available with OBJECT_STORAGE_PROVIDER=replit and PRIVATE_OBJECT_DIR.
OBJECT_STORAGE_PROVIDER=postgres

# development | production
NODE_ENV=development

# Local-only backdoor: enables GET /api/dev/login (no password). NEVER set in production.
ENABLE_DEV_LOGIN=true

# Retired — startup never applies schema changes. AUTO_MIGRATE=true, 1 or yes
# now stops normal startup with a clear error, including case/space variants.
# Leave it unset or false. Schema rollout needs reviewed SQL tied to the exact
# source, database target and approved backup/restore procedure.
# AUTO_MIGRATE=false

# Optional — AI concierge / assistant features
# OPENAI_API_KEY=sk-...
# Evidence Intelligence defaults to OpenAI's flagship quality model. Override
# only after the Proof Lab shows a lower-cost model meets the same trust gates.
# OPENAI_EVIDENCE_MODEL=gpt-5.6-sol

# --- Billing (Stripe) — optional. Without these, billing is disabled (free beta). ---
# STRIPE_SECRET_KEY=sk_test_...        # enables billing
# STRIPE_PRICE_ID=price_...            # the recurring price customers subscribe to
# STRIPE_WEBHOOK_SECRET=whsec_...      # from `stripe listen` or the dashboard webhook
# BILLING_ENFORCE=true                 # actually gate access on subscription status (default: off)
