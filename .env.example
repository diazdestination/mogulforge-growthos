# MogulForge — environment template.
# Local dev: copy to artifacts/api-server/.env  (the API has no dotenv; start-dev.ps1 loads this).
# Docker:    copy to .env at the repo root      (docker compose reads it automatically).

# API server port
PORT=3001

# Postgres connection.
#   local dev  -> host  localhost
#   docker     -> host  db   (the compose service name)
DATABASE_URL=postgresql://postgres:mogulforge@localhost:5432/mogulforge

# Email Intelligence Inbox (founding beta). Leave blank until the inbound
# provider bridge and DNS are deliberately configured. Keys must decode to
# exactly 32 bytes and must not reuse the OAuth token encryption key.
EMAIL_INGESTION_DOMAIN=
EMAIL_INGESTION_WEBHOOK_SECRET=
EMAIL_INTELLIGENCE_ENCRYPTION_KEY=

# Long random string that signs sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin used for same-origin authorization and links in email.
APP_ORIGIN=http://localhost:5000

# --- MogulForge transactional account email ---
# Required in production for account verification, password recovery, and
# team invitations. This platform-owned channel is intentionally separate
# from each user's connected Gmail account. RESEND_FROM_EMAIL must use a
# sender/domain verified in Resend; production fails closed when either value
# is absent so GrowthOS never reports an undelivered identity email as sent.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MogulForge <account@mogulforge.ai>
# Required for Resend delivery callbacks; missing/malformed signing secrets
# reject all requests, including in local development. Never commit real keys.
# RESEND_WEBHOOK_SECRET=whsec_...

# Staging email acceptance requires a released hold, explicit approval and
# exact approved inboxes together. The deployed staging config keeps them off.
# GROWTHOS_OUTBOUND_HOLD=true
# STAGING_OUTBOUND_APPROVED=false
# STAGING_EMAIL_RECIPIENT_ALLOWLIST=qa@example.test,owner@example.test

# Founding-beta access gate. In production, new self-service registrations are
# rejected unless their lowercase email appears in this comma-separated list.
# Users pre-provisioned through the in-app team invite flow are always allowed
# and their signed invitation proves mailbox control at account creation.
# Local development and tests stay open when this is unset.
# BETA_SIGNUP_ALLOWLIST=founder@example.com,beta-owner@example.com

# --- Per-user Gmail OAuth (GrowthOS users connect their own mailbox) ---
# Create separate Google Cloud OAuth clients/projects for local testing and production.
# Request only Gmail send access; never store these values in source control.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/integrations/gmail/callback
# 32 random bytes encoded as base64 or 64 hex characters. Rotating this key
# requires a credential re-encryption migration or users must reconnect.
# OAUTH_TOKEN_ENCRYPTION_KEY=...

# Portable default stores private photo uploads in Postgres. Legacy Replit/GCS
# remains available with OBJECT_STORAGE_PROVIDER=replit and PRIVATE_OBJECT_DIR.
OBJECT_STORAGE_PROVIDER=postgres

# development | production
NODE_ENV=development

# Local-only backdoor: enables GET /api/dev/login (no password). NEVER set in production.
ENABLE_DEV_LOGIN=true

# Optional — apply the DB schema at startup instead of via fly.toml's
# release_command. Useful when the deploy path doesn't carry our fly.toml (e.g.
# Fly's dashboard "launch from GitHub"), which would otherwise start the app
# against an empty database. Advisory-locked, so multiple machines are safe.
# Fine for a single-machine beta; prefer release_command once you have real data.
# AUTO_MIGRATE=true
# MIGRATE_CWD=/app                     # only if the repo root isn't ../.. from the API

# Optional — AI concierge / assistant features
# OPENAI_API_KEY=sk-...
# Evidence Intelligence defaults to OpenAI's flagship quality model. Override
# only after the Proof Lab shows a lower-cost model meets the same trust gates.
# OPENAI_EVIDENCE_MODEL=gpt-5.6-sol

# --- Billing (Stripe) — optional. Without these, billing is disabled (free beta). ---
# STRIPE_SECRET_KEY=sk_test_...        # enables billing
# STRIPE_PRICE_ID=price_...            # the recurring price customers subscribe to
# STRIPE_WEBHOOK_SECRET=whsec_...      # from `stripe listen` or the dashboard webhook
# BILLING_ENFORCE=true                 # actually gate access on subscription status (default: off)
