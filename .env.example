# MogulForge — environment template.
# Local dev: copy to artifacts/api-server/.env  (the API has no dotenv; start-dev.ps1 loads this).
# Docker:    copy to .env at the repo root      (docker compose reads it automatically).

# API server port
PORT=3001

# Postgres connection.
#   local dev  -> host  localhost
#   docker     -> host  db   (the compose service name)
DATABASE_URL=postgresql://postgres:mogulforge@localhost:5432/mogulforge

# Long random string that signs sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# development | production
NODE_ENV=development

# Local-only backdoor: enables GET /api/dev/login (no password). NEVER set in production.
ENABLE_DEV_LOGIN=true

# Optional — AI concierge / assistant features
# OPENAI_API_KEY=sk-...

# --- Billing (Stripe) — optional. Without these, billing is disabled (free beta). ---
# STRIPE_SECRET_KEY=sk_test_...        # enables billing
# STRIPE_PRICE_ID=price_...            # the recurring price customers subscribe to
# STRIPE_WEBHOOK_SECRET=whsec_...      # from `stripe listen` or the dashboard webhook
# BILLING_ENFORCE=true                 # actually gate access on subscription status (default: off)
