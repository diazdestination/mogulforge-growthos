# Local preparation only. Do not install into an existing deployment.
# Painless is prospective and is NOT authorized for activation.
# A twilio_client_bindings row, rather than old global TWILIO_ORGANIZATION_ID,
# selects one client account/number. Every database launch flag defaults false.
# Populate these secret references only in an approved server secret store.
TWILIO_CLIENT_PAINLESS_AUTH_TOKEN=
TWILIO_CLIENT_PAINLESS_API_KEY_SECRET=
