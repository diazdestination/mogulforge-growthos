# Local preparation only. Do not install into an existing deployment.
# Painless is a prospective client; the shared tenant-provider adapter is pending.
# This exact template is exercised by test:twilio and must remain disabled.
TWILIO_VOICE_BUSINESS_NAME="Painless Roofing & Water Restoration"
TWILIO_VOICE_ENABLED=false
TWILIO_VOICE_APPROVED=false
TWILIO_SMS_ENABLED=false
TWILIO_REGISTRATION_APPROVED=false
TWILIO_ADVANCED_OPT_OUT=false
TWILIO_LAUNCH_APPROVED=false
TWILIO_GEO_PERMISSIONS_REVIEWED=false
TWILIO_DAILY_CALL_LIMIT=0
TWILIO_DAILY_SMS_LIMIT=0
# Binding/credential fields deliberately blank, never fabricated or committed.
TWILIO_ORGANIZATION_ID=
TWILIO_PUBLIC_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_STAFF_PHONE=
TWILIO_MESSAGING_SERVICE_SID=
